import matplotlib.pyplot as plt
import pandas as pd
import scipy.stats as st

# Load dataset
df = pd.read_csv("datasheet.csv")
uefa = df[df["Confederation"] == "UEFA"]["Shots_per_90"]
non_uefa = df[df["Confederation"] == "Non-UEFA"]["Shots_per_90"]

# Calculate 95% Confidence Intervals using t-distribution
ci_u = st.t.interval(
    0.95, df=len(uefa) - 1, loc=uefa.mean(), scale=st.sem(uefa)
)
ci_nu = st.t.interval(
    0.95, df=len(non_uefa) - 1, loc=non_uefa.mean(), scale=st.sem(non_uefa)
)

means = [uefa.mean(), non_uefa.mean()]
errors = [uefa.mean() - ci_u[0], non_uefa.mean() - ci_nu[0]]

# Plot Error Bars
plt.figure(figsize=(7, 5))
plt.errorbar(
    ["UEFA Teams", "Non-UEFA Teams"],
    means,
    yerr=errors,
    fmt="o",
    color="darkblue",
    elinewidth=3,
    capsize=8,
    capthick=2,
    markersize=8,
)

plt.title("Week 3: 95% Confidence Intervals", fontsize=12, fontweight="bold")
plt.ylabel("Mean Shots/90 (with 95% CI)")
plt.grid(True, linestyle="--", alpha=0.5)

# Add numerical annotations
plt.annotate(
    f"{means[0]:.2f} [{ci_u[0]:.2f}, {ci_u[1]:.2f}]",
    (0, means[0] + 0.35),
    ha="center",
    fontsize=9,
    fontweight="bold",
)
plt.annotate(
    f"{means[1]:.2f} [{ci_nu[0]:.2f}, {ci_nu[1]:.2f}]",
    (1, means[1] + 0.35),
    ha="center",
    fontsize=9,
    fontweight="bold",
)

plt.tight_layout()
plt.savefig("chart2_confidence_intervals.png", dpi=300)
plt.show()
